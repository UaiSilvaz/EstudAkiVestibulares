  "matematica": [
    {
      "selector": ".math-icon",
      "keyframes": [
        {
          "transform": "translateY(0px) scale(1) rotate(0deg)"
        },
        {
          "transform": "translateY(-5px) scale(1.07) rotate(-2deg)",
          "offset": 0.36
        },
        {
          "transform": "translateY(1px) scale(.99) rotate(1deg)",
          "offset": 0.72
