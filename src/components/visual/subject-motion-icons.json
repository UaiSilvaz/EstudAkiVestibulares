{
  "_meta": {
    "name": "EstudAki Subject Icons Motion",
    "version": "7.1.0",
    "engine": "Web Animations API",
    "style": "colorful-duotone-3d-soft",
    "notes": "V7.1: Filosofia refinada com busto clássico sem feições caricatas, esfera de ideia dourada e brilho.",
