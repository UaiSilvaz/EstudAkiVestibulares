        }
      ],
      "options": {
        "duration": 640,
        "delay": 40,
        "easing": "cubic-bezier(.34,1.56,.64,1)"
      }
    },
    {
      "selector": ".math-tile-minus",
      "keyframes": [
        {
          "transform": "translate(1px,1px) rotate(3deg) scale(.96)"
        },
        {
          "transform": "translate(3px,-2px) rotate(7deg) scale(1.07)",
          "offset": 0.5
        },
        {
          "transform": "translate(0,0) rotate(0deg) scale(1)",
          "offset": 1
        }
      ],
      "options": {
        "duration": 660,
        "delay": 70,
        "easing": "cubic-bezier(.34,1.56,.64,1)"
      }
    },
    {
      "selector": ".math-tile-times",
