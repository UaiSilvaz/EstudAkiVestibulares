      ],
      "options": {
        "duration": 760,
        "easing": "cubic-bezier(.22,1,.36,1)"
      }
    },
    {
      "selector": ".math-tile-plus",
      "keyframes": [
        {
          "transform": "translate(-1px,1px) rotate(-4deg) scale(.96)"
        },
        {
          "transform": "translate(-3px,-3px) rotate(-8deg) scale(1.08)",
          "offset": 0.5
