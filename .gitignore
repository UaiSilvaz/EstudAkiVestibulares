# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-artifacts/

# next.js
/.next/
/out/

# production
/build

# local databases and generated uploads
prisma/*.db
public/uploads/**
!public/uploads/
!public/uploads/**/
!public/uploads/**/.gitkeep

# private source files and generated datasets
/data/
/storage/*
!/storage/exams/
!/storage/exams/.gitkeep
/private-materials/
/private-old-exams/

# generated public artifacts synced from storage/pipelines
/public/provas-antigas/
/public/question-assets/
/public/questoes/
/public/assets/jornada-icons/*
!/public/assets/jornada-icons/
!/public/assets/jornada-icons/*-compact.png

# generated import outputs
/scripts/import/output/

# misc
.DS_Store
*.pem

# PDFs privados enviados pelo painel (metadados ficam no banco)
/storage/exams/*
!/storage/exams/.gitkeep

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
dev-server*.log
.pilot-*.log
/test-artifacts/*.log
.codex/
.codex-dev-*.log
.codex-dev-*.out.log
.codex-dev-*.err.log

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# supabase local link/cache
supabase/.temp/

# typescript
*.tsbuildinfo
next-env.d.ts

# python
__pycache__/
*.py[cod]

/src/generated/prisma
