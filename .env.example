# Supabase/PostgreSQL
# Use a pooled URL for runtime DATABASE_URL and the direct URL for Prisma migrations.
# Replace PROJECT_REF, PASSWORD and region/host with the values from Supabase.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres"

# Auth/session
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Gere um segredo aleatório de pelo menos 32 bytes. É obrigatório em produção.
SESSION_SECRET=""
# Opcional para deploys multi-instancia com Server Actions.
# Gere com: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""
# Somente desenvolvimento/teste: credenciais opcionais para emitir a sessão
# local-admin. Elas são ignoradas integralmente em produção.
LOCAL_ADMIN_EMAIL=""
LOCAL_ADMIN_PASSWORD=""
# Migração local opcional para cookies antigos com ID persistido sem assinatura.
# Nunca habilite em produção; IDs local-admin/local-user já são tratados só em dev/teste.
ALLOW_LEGACY_SESSION_COOKIE="false"
# O seed exige estas credenciais em produção; não reutilize senhas de exemplo.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# Armazenamento privado em producao. Crie os buckets "exam-pdfs",
# "material-pdfs", "question-images" e "official-exam-files".
# Sem estas variaveis, o desenvolvimento usa storage/exams no disco local.
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# Webhooks
HOTMART_HOTTOK_SECRET=""

# Opcional: geração assistida de resoluções, sempre sujeita à revisão humana.
OPENAI_API_KEY=""
OPENAI_RESOLUTION_MODEL="gpt-5.4-mini"

# Mantenha false em produção. O piloto temporário também exige confirmação
# adicional no endpoint, mesmo quando esta chave é habilitada explicitamente.
ALLOW_ENEM_2025_PILOT_TEST="false"
