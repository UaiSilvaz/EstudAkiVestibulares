{
  "name": "estudaki-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/run-next-with-system-ca.mjs dev",
    "build": "node scripts/run-next-with-system-ca.mjs build --webpack",
    "start": "node scripts/run-next-with-system-ca.mjs start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/lib/achievement-catalog.test.ts src/lib/insights.test.ts src/lib/jornada-curriculum.test.ts src/lib/old-exam-language.test.ts src/lib/old-exam-proof.test.ts src/lib/question-filter-url.test.ts src/lib/question-filters.test.ts src/lib/session-cookie.test.ts src/lib/student-question-payload.test.ts",
    "verify": "npm run lint && npm run typecheck && npm test",
    "security:audit": "npm audit --omit=dev",
    "clean:local": "node scripts/clean-local-artifacts.mjs",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "achievements:seed": "tsx scripts/ensure-duolingo-achievements.ts",
    "achievements:test": "tsx --test src/lib/achievement-catalog.test.ts",
    "enem:mapear": "python scripts/enem/enem_pipeline.py mapear",
    "enem:extrair": "python scripts/enem/enem_pipeline.py extrair --resume",
    "enem:gabaritos": "python scripts/enem/enem_pipeline.py gabaritos",
    "enem:validar": "python scripts/enem/enem_pipeline.py validar",
    "enem:piloto": "python scripts/enem/enem_pipeline.py piloto --resume",
    "enem:importar": "tsx scripts/enem/import-pilot-2022-day2.ts",
    "enem:revisar": "tsx scripts/enem/review-pilot-2022-day2.ts",
    "enem:backup": "tsx scripts/enem/backup-pilot-2022-day2.ts",
    "enem:exportar": "tsx scripts/enem/export-pilot-2022-day2.ts",
    "enem:validar-publicacao": "tsx scripts/enem/publish-pilot-2022-day2.ts",
    "enem:publicar": "tsx scripts/enem/publish-pilot-2022-day2.ts",
    "enem:corpus": "tsx scripts/enem/import-corpus-booklet.ts",
    "enem:corpus:test": "tsx --test scripts/enem/corpus-importer-core.test.ts",
    "provas-antigas:register": "tsx scripts/register-old-exams.ts",
    "provas-antigas:extract": "tsx scripts/import/extract-old-exams.ts",
    "provas-antigas:import": "tsx scripts/import/import-reviewed-questions.ts",
    "questions:search-sources": "tsx scripts/import/search-question-sources.ts",
    "questions:import-official": "tsx scripts/import/import-reviewed-questions.ts",
    "questions:import-official-index": "tsx scripts/import/import-official-question-index.ts",
    "questions:generate-authoral": "tsx scripts/import/generate-authoral-bank.ts",
    "questions:generate-explanations": "tsx scripts/import/generate-explanations.ts",
    "questions:validate": "tsx scripts/import/validate-question-bank.ts",
    "questions:import-bank": "tsx scripts/import/import-question-bank.ts",
    "questions:import-enem-html": "tsx scripts/import/import-enem-html-bank.ts",
    "questions:import-enem-sql": "node scripts/import/import-enem-screenshot-sql.mjs",
    "questions:audit-publication": "tsx scripts/import/audit-question-publication.ts",
    "questions:audit-enem": "tsx scripts/import/audit-enem-bank.ts",
    "questions:normalize-portuguese": "tsx scripts/import/normalize-question-portuguese.ts",
    "questions:split-enem-parts": "tsx scripts/import/split-enem-question-parts.ts",
    "questions:extract-sources": "tsx scripts/import/extract-question-source-fields.ts",
    "questions:sync-assets": "tsx scripts/import/sync-question-assets.ts",
    "questions:sync-storage": "node scripts/sync-question-assets-to-supabase.mjs",
    "questions:publish-authorial": "tsx scripts/import/publish-authorial-questions.ts",
    "questions:import-all": "npm run questions:search-sources && npm run questions:generate-authoral && npm run questions:generate-explanations && npm run questions:import-bank -- --confirm-import && npm run questions:validate",
    "official-sources:seed": "tsx scripts/seed-official-sources.ts",
    "official-sources:register-enem-corpus": "tsx scripts/enem/register-official-corpus.ts",
    "official-sources:sync-enem-canonical": "tsx scripts/sync-enem-canonical-old-exams.ts",
    "official-sources:sync-fuvest-canonical": "tsx scripts/sync-fuvest-canonical-old-exams.ts",
    "official-sources:pilot-enem-2025": "tsx scripts/import/import-enem-2025-pilot.ts",
    "study-plan:generate": "tsx scripts/generate-study-plan.ts",
    "verify:learning": "tsx scripts/verify-learning-platform.ts",
    "flashcards:extract": "python scripts/extract-anki-flashcards.py",
    "flashcards:import": "tsx scripts/import-anki-flashcards.ts",
    "flashcards:sync": "npm run flashcards:extract && npm run flashcards:import",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.17.0",
    "next": "^16.3.0",
    "pdfjs-dist": "^6.2.108",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.35.3",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
