generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  TEACHER
  MENTOR
  COORDINATOR
  ADMIN
}

enum ContentStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum MaterialType {
  PDF
  SUMMARY
  MINDMAP
  SLIDES
  SHEET
}

enum VideoKind {
  LESSON
  EXPRESS
  RESOLUTION
}

enum ActivityType {
  XP
  QUESTION
  STREAK
  CHALLENGE
  CONTENT
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(STUDENT)
  avatarUrl    String?
  xp           Int      @default(0)
  streak       Int      @default(0)
  league       String   @default("Bronze")
  weeklyHours  Int      @default(8)
  targetExam   String   @default("ENEM")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  activities        Activity[]
  attempts          QuestionAttempt[]
  authoredQuestions Question[]        @relation("QuestionAuthor")
  authoredVideos    Video[]           @relation("VideoAuthor")
  achievements      UserAchievement[]
  studySessions     StudySession[]
  videoComments     VideoComment[]
  videoLikes        VideoLike[]
  videoSaves        VideoSave[]
}

model Vestibular {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logo        String?
  color       String   @default("#1E73FF")
  description String
  weightMap   String   @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  exams     Exam[]
  questions Question[]
  simulados Simulado[]
}

model Subject {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  color       String   @default("#1E73FF")
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  flashcards Flashcard[]
  materials  Material[]
  questions  Question[]
  topics     Topic[]
  videos     Video[]
}

model Topic {
  id        String   @id @default(cuid())
  subjectId String
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  flashcards Flashcard[]
  materials  Material[]
  questions  Question[]
  subject    Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  videos     Video[]
}

model Question {
  id                 String        @id @default(cuid())
  vestibularId       String
  subjectId          String
  topicId            String?
  authorId           String?
  year               Int
  difficulty         Difficulty    @default(MEDIUM)
  statement          String
  alternatives       String
  correctAlternative String
  explanation        String
  pedagogyComment    String?
  videoUrl           String?
  imageUrl           String?
  tags               String        @default("[]")
  source             String?
  status             ContentStatus @default(REVIEW)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  attempts    QuestionAttempt[]
  author      User?             @relation("QuestionAuthor", fields: [authorId], references: [id])
  subject     Subject           @relation(fields: [subjectId], references: [id])
  topic       Topic?            @relation(fields: [topicId], references: [id])
  vestibular  Vestibular        @relation(fields: [vestibularId], references: [id])
  videos      Video[]
}

model QuestionAttempt {
  id                String   @id @default(cuid())
  userId            String
  questionId        String
  selectedAlternative String
  correct           Boolean
  timeSpentSeconds  Int      @default(0)
  errorType         String?
  reviewed          Boolean  @default(false)
  createdAt         DateTime @default(now())
  reviewedAt        DateTime?

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([questionId])
  @@index([correct, reviewed])
}

model Exam {
  id           String        @id @default(cuid())
  vestibularId String
  title        String
  year         Int
  phase        String
  day          String?
  pdfUrl       String?
  answerKeyUrl String?
  sourceUrl    String?
  imageUrl     String?
  questionCount Int?
  durationMinutes Int?
  official     Boolean       @default(true)
  color        String        @default("#1E73FF")
  status       ContentStatus @default(PUBLISHED)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  vestibular Vestibular @relation(fields: [vestibularId], references: [id], onDelete: Cascade)
}

model Material {
  id          String        @id @default(cuid())
  subjectId   String?
  topicId     String?
  title       String
  type        MaterialType  @default(PDF)
  category    String
  premium     Boolean       @default(false)
  fileUrl     String?
  priceCents  Int           @default(0)
  purchaseUrl String?
  description String
  status      ContentStatus @default(PUBLISHED)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  subject Subject? @relation(fields: [subjectId], references: [id])
  topic   Topic?   @relation(fields: [topicId], references: [id])
}

model Video {
  id              String        @id @default(cuid())
  authorId        String?
  subjectId       String?
  topicId         String?
  questionId      String?
  title           String
  description     String
  kind            VideoKind     @default(EXPRESS)
  durationSeconds Int           @default(90)
  thumbnailUrl    String?
  videoUrl        String?
  status          ContentStatus @default(PUBLISHED)
  views           Int           @default(0)
  likes           Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  author   User?      @relation("VideoAuthor", fields: [authorId], references: [id])
  question Question?  @relation(fields: [questionId], references: [id])
  subject  Subject?   @relation(fields: [subjectId], references: [id])
  topic    Topic?     @relation(fields: [topicId], references: [id])
  comments VideoComment[]
  likeRecords VideoLike[]
  saveRecords VideoSave[]
}

model VideoLike {
  id        String   @id @default(cuid())
  userId    String
  videoId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
}

model VideoSave {
  id        String   @id @default(cuid())
  userId    String
  videoId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
}

model VideoComment {
  id        String   @id @default(cuid())
  userId    String
  videoId   String
  body      String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
}

model Achievement {
  id           String        @id @default(cuid())
  slug         String        @unique
  title        String
  description  String
  icon         String        @default("trophy")
  color        String        @default("#F97316")
  xpReward     Int          @default(0)
  criteriaType String
  criteriaValue Int         @default(1)
  status       ContentStatus @default(PUBLISHED)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  users UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  progress      Int      @default(0)
  completed     Boolean  @default(false)
  unlockedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId, completed])
}

model StudySession {
  id                String   @id @default(cuid())
  userId            String
  focus             String   @default("questions")
  durationSeconds   Int      @default(0)
  questionsAnswered Int      @default(0)
  correctAnswers    Int      @default(0)
  notes             String?
  startedAt         DateTime @default(now())
  endedAt           DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
}

model Flashcard {
  id        String        @id @default(cuid())
  subjectId String?
  topicId   String?
  front     String
  back      String
  status    ContentStatus @default(PUBLISHED)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  subject Subject? @relation(fields: [subjectId], references: [id])
  topic   Topic?   @relation(fields: [topicId], references: [id])
}

model Simulado {
  id           String        @id @default(cuid())
  vestibularId String
  title        String
  description  String
  durationMin  Int           @default(180)
  questionIds  String        @default("[]")
  status       ContentStatus @default(PUBLISHED)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  vestibular Vestibular @relation(fields: [vestibularId], references: [id], onDelete: Cascade)
}

model Challenge {
  id          String        @id @default(cuid())
  title       String
  description String
  rewardXp    Int           @default(250)
  goal        Int           @default(30)
  metric      String        @default("questions")
  status      ContentStatus @default(PUBLISHED)
  startsAt    DateTime      @default(now())
  endsAt      DateTime
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Activity {
  id        String       @id @default(cuid())
  userId    String?
  type      ActivityType @default(XP)
  message   String
  xp        Int          @default(0)
  createdAt DateTime     @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}
