  role           String   @default("MEMBER")
  joinedAt       DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId, joinedAt])
}

model ChatMessage {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  content        String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model StudyPlanPreference {
  id            String    @id @default(cuid())
  userId        String    @unique
  availableDays String    @default("[1,2,3,4,5]")
  minutesPerDay Int       @default(90)
  examDate      DateTime?
  updatedAt     DateTime  @updatedAt
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StudyPlanTask {
  id                String           @id @default(cuid())
  userId            String
  userPreparationId String?
  userPreparation   UserPreparation? @relation(fields: [userPreparationId], references: [id], onDelete: SetNull)
  scheduledFor      DateTime
  type              String
  title             String
  description       String
  durationMinutes   Int
  subjectId         String?
  topicId           String?
  actionHref        String
  completedAt       DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, scheduledFor])
  @@index([userId, completedAt])
  @@index([userPreparationId, scheduledFor])
}

enum PreparationLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum UserPreparationStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum EntitlementSource {
  PURCHASE
  PROMOTION
  ADMIN
  LEGACY
  SUBSCRIPTION
}

enum FlashcardReviewState {
  NEW
  LEARNING
  REVIEW
  MASTERED
}

model Vertical {
  id           String        @id @default(cuid())
  slug         String        @unique
  name         String
  themeKey     String
  enabled      Boolean       @default(true)
  preparations Preparation[]
}

model Preparation {
  id              String               @id @default(cuid())
  verticalId      String
  slug            String               @unique
  name            String
  description     String               @default("")
  examSlug        String?
  status          ContentStatus        @default(DRAFT)
  isFree          Boolean              @default(false)
  defaultExamDate DateTime?
  coverUrl        String?
  features        Json                 @default("{}")
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  vertical        Vertical             @relation(fields: [verticalId], references: [id], onDelete: Restrict)
  memberships     UserPreparation[]
  activeUsers     User[]               @relation("ActivePreparation")
  courses         PreparationCourse[]
  tracks          PreparationTrack[]
  products        PreparationProduct[]
  entitlements    Entitlement[]
  posts           CommunityPost[]
  rooms           StudyRoom[]

  @@index([verticalId, status])
}

model UserPreparation {
  id                String                @id @default(cuid())
  userId            String
  preparationId     String
  displayName       String?
  examDate          DateTime?
  minutesPerDay     Int                   @default(90)
  studyDays         Json                  @default("[1,2,3,4,5]")
  level             PreparationLevel      @default(BEGINNER)
  difficultSubjects Json                  @default("[]")
  experience        String?
  selectedTrackId   String?
  status            UserPreparationStatus @default(ACTIVE)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  preparation       Preparation           @relation(fields: [preparationId], references: [id], onDelete: Restrict)
  selectedTrack     Track?                @relation(fields: [selectedTrackId], references: [id], onDelete: SetNull)
  studyPlanTasks    StudyPlanTask[]
  studySessions     StudySession[]
  essays            EssaySubmission[]

  @@unique([userId, preparationId])
  @@index([userId, status, updatedAt])
}

model Course {
  id                   String                @id @default(cuid())
  slug                 String                @unique
  title                String
  description          String                @default("")
  shortDescription     String                @default("")
  thumbnail            String?
  coverImage           String?
  category             String                @default("ENEM")
  level                String                @default("Base")
  priceCents           Int                   @default(0)
  isFree               Boolean               @default(false)
  published            Boolean               @default(false)
  featured             Boolean               @default(false)
  teacherId            String?
  subjectId            String?
  status               ContentStatus         @default(DRAFT)
  coverUrl             String?
  totalDurationSeconds Int                   @default(0)
  navigationMode       CourseNavigationMode  @default(SEQUENTIAL)
  visualTheme          Json                  @default("{}")
  benefits             Json                  @default("[]")
  rating               Float                 @default(4.8)
  studentsCount        Int                   @default(0)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  teacher              User?                 @relation("CourseTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  subject              Subject?              @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  modules              CourseModule[]
  preparations         PreparationCourse[]
  tracks               TrackCourse[]
  products             CourseProduct[]
  entitlements         Entitlement[]
  rewards              Reward[]
  simulations          Simulation[]
  reviews              CourseReview[]
  events               LearningEvent[]
  revenueShares        ContentRevenueShare[]

  @@index([status, subjectId])
  @@index([published, featured])
  @@index([category, level])
}

model Module {
  id          String         @id @default(cuid())
  slug        String         @unique
  title       String
  description String         @default("")
  eyebrow     String         @default("")
  color       String         @default("#1E73FF")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  courses     CourseModule[]
  lessons     ModuleLesson[]
  rewards     Reward[]
  simulations Simulation[]
}

model CourseModule {
  courseId String
  moduleId String
  position Int    @default(0)
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Restrict)

  @@id([courseId, moduleId])
  @@index([courseId, position])
  @@index([moduleId])
}

model Lesson {
  id                    String                  @id @default(cuid())
  slug                  String                  @unique
  title                 String
  description           String                  @default("")
  content               String?
  type                  LessonNodeType          @default(VIDEO)
  videoId               String?
  videoUrl              String?
  videoProvider         VideoProvider           @default(LOCAL)
  materialId            String?
  subjectId             String?
  topicId               String?
  durationSeconds       Int                     @default(0)
  xpReward              Int                     @default(50)
  isFreePreview         Boolean                 @default(false)
  allowManualCompletion Boolean                 @default(true)
  resources             Json                    @default("[]")
  outcomes              Json                    @default("[]")
  status                ContentStatus           @default(DRAFT)
  isFree                Boolean                 @default(false)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  video                 Video?                  @relation(fields: [videoId], references: [id], onDelete: SetNull)
  material              Material?               @relation(fields: [materialId], references: [id], onDelete: SetNull)
  subject               Subject?                @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  topic                 Topic?                  @relation(fields: [topicId], references: [id], onDelete: SetNull)
  modules               ModuleLesson[]
  progress              LessonProgress[]
  notes                 LessonNote[]
  authors               LessonAuthor[]
  likes                 LessonLike[]
  favorites             LessonFavorite[]
  comments              LessonComment[]
  questions             LessonQuestion[]
  questionAttempts      LessonQuestionAttempt[]
  simulations           Simulation[]
  rewards               Reward[]
  events                LearningEvent[]
  revenueShares         ContentRevenueShare[]

  @@index([status, subjectId, topicId])
  @@index([type, status])
}

model ModuleLesson {
  moduleId String
  lessonId String
  position Int    @default(0)
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Restrict)

  @@id([moduleId, lessonId])
  @@index([moduleId, position])
  @@index([lessonId])
}

model PreparationCourse {
  preparationId String
  courseId      String
  position      Int         @default(0)
  preparation   Preparation @relation(fields: [preparationId], references: [id], onDelete: Cascade)
  course        Course      @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@id([preparationId, courseId])
  @@index([preparationId, position])
  @@index([courseId])
}

model Track {
  id             String             @id @default(cuid())
  slug           String             @unique
  title          String
  description    String             @default("")
  weeklyMinutes  Int?
  estimatedWeeks Int?
  level          PreparationLevel   @default(BEGINNER)
  status         ContentStatus      @default(DRAFT)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  courses        TrackCourse[]
  preparations   PreparationTrack[]
  memberships    UserPreparation[]
}

model PreparationTrack {
  preparationId String
  trackId       String
  position      Int         @default(0)
  preparation   Preparation @relation(fields: [preparationId], references: [id], onDelete: Cascade)
  track         Track       @relation(fields: [trackId], references: [id], onDelete: Restrict)

  @@id([preparationId, trackId])
  @@index([preparationId, position])
  @@index([trackId])
}

model TrackCourse {
  trackId  String
  courseId String
  position Int    @default(0)
  track    Track  @relation(fields: [trackId], references: [id], onDelete: Cascade)
  course   Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  @@id([trackId, courseId])
  @@index([trackId, position])
  @@index([courseId])
}

model LessonProgress {
  id              String    @id @default(cuid())
  userId          String
  lessonId        String
  positionSeconds Int       @default(0)
  watchedSeconds  Int       @default(0)
  percentage      Float     @default(0)
  completed       Boolean   @default(false)
  stars           Int       @default(0)
  xpAwarded       Int       @default(0)
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson          Lesson    @relation(fields: [lessonId], references: [id], onDelete: Restrict)

  @@unique([userId, lessonId])
  @@index([userId, updatedAt])
}

model LessonNote {
  id              String   @id @default(cuid())
  userId          String
  lessonId        String
  content         String   @default("")
  positionSeconds Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson          Lesson   @relation(fields: [lessonId], references: [id], onDelete: Restrict)

  @@unique([userId, lessonId])
}

model LessonLike {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([lessonId, createdAt])
}

model LessonFavorite {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId, createdAt])
}

model LessonComment {
  id              String            @id @default(cuid())
  userId          String
  lessonId        String
  parentId        String?
  kind            LessonCommentKind @default(DISCUSSION)
  body            String
  positionSeconds Int?
  helpful         Boolean           @default(false)
  reportedAt      DateTime?
  editedAt        DateTime?
  deletedAt       DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson  Lesson              @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  parent  LessonComment?      @relation("LessonCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies LessonComment[]     @relation("LessonCommentReplies")
  likes   LessonCommentLike[]

  @@index([lessonId, kind, createdAt])
  @@index([parentId])
}

model LessonCommentLike {
  id        String   @id @default(cuid())
  userId    String
  commentId String
  createdAt DateTime @default(now())

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment LessonComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
  @@index([commentId, createdAt])
}

model LessonQuestion {
  id         String   @id @default(cuid())
  lessonId   String
  questionId String
  order      Int      @default(0)
  xpReward   Int      @default(10)
  createdAt  DateTime @default(now())

  lesson   Lesson                  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  question Question                @relation(fields: [questionId], references: [id], onDelete: Cascade)
  attempts LessonQuestionAttempt[]

  @@unique([lessonId, questionId])
  @@index([lessonId, order])
  @@index([questionId])
}

model LessonQuestionAttempt {
  id                  String   @id @default(cuid())
  userId              String
  lessonId            String
  lessonQuestionId    String?
  questionId          String
  selectedAlternative String
  correct             Boolean
  xpAwarded           Int      @default(0)
  createdAt           DateTime @default(now())

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson         Lesson          @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonQuestion LessonQuestion? @relation(fields: [lessonQuestionId], references: [id], onDelete: SetNull)
  question       Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([userId, lessonId, createdAt])
  @@index([questionId])
}

model Simulation {
  id              String   @id @default(cuid())
  courseId        String
  moduleId        String?
  lessonId        String?
  title           String
  description     String   @default("")
  questionIds     Json     @default("[]")
  durationMinutes Int      @default(15)
  passingScore    Int      @default(70)
  xpReward        Int      @default(150)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  course   Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module   Module?             @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  lesson   Lesson?             @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  attempts SimulationAttempt[]

  @@index([courseId, moduleId])
  @@index([lessonId])
}

model SimulationAttempt {
  id             String   @id @default(cuid())
  userId         String
  simulationId   String
  responses      Json     @default("{}")
  correctCount   Int      @default(0)
  totalQuestions Int      @default(0)
  score          Float    @default(0)
  timeSeconds    Int      @default(0)
  passed         Boolean  @default(false)
  xpAwarded      Int      @default(0)
  submittedAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  simulation Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)

  @@index([userId, submittedAt])
  @@index([simulationId, submittedAt])
}

model Reward {
  id          String   @id @default(cuid())
  courseId    String
  moduleId    String?
  lessonId    String?
  slug        String   @unique
  title       String
  description String   @default("")
  xpReward    Int      @default(100)
  badge       String   @default("")
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module      Module?      @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  lesson      Lesson?      @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  userRewards UserReward[]

  @@index([courseId, moduleId])
  @@index([lessonId])
}

model UserReward {
  id        String   @id @default(cuid())
  userId    String
  rewardId  String
  claimedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  reward Reward @relation(fields: [rewardId], references: [id], onDelete: Cascade)

  @@unique([userId, rewardId])
  @@index([userId, claimedAt])
}

model CourseReview {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  rating    Int
  comment   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId, createdAt])
}

model LearningEvent {
  id        String            @id @default(cuid())
  userId    String?
  courseId  String?
  lessonId  String?
  type      LearningEventType
  metadata  Json              @default("{}")
  createdAt DateTime          @default(now())

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  course Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson Lesson? @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([courseId, createdAt])
  @@index([lessonId, createdAt])
}

model LessonAuthor {
  lessonId String
  userId   String
  role     String @default("AUTHOR")
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([lessonId, userId, role])
  @@index([userId])
}

model ContentRevenueShare {
  id               String    @id @default(cuid())
  userId           String
  lessonId         String?
  courseId         String?
  materialId       String?
  shareBasisPoints Int       @default(0)
  validFrom        DateTime  @default(now())
  validUntil       DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  lesson           Lesson?   @relation(fields: [lessonId], references: [id], onDelete: Restrict)
  course           Course?   @relation(fields: [courseId], references: [id], onDelete: Restrict)
  material         Material? @relation(fields: [materialId], references: [id], onDelete: Restrict)

  @@index([userId, validFrom])
}

model PreparationProduct {
  preparationId String
  productId     String
  preparation   Preparation @relation(fields: [preparationId], references: [id], onDelete: Cascade)
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([preparationId, productId])
  @@index([productId])
}

model CourseProduct {
  courseId  String
  productId String
  course    Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([courseId, productId])
  @@index([productId])
}

model Entitlement {
  id            String            @id @default(cuid())
  userId        String
  productId     String?
  preparationId String?
  courseId      String?
  purchaseId    String?
  sourceType    EntitlementSource
  sourceKey     String
  validFrom     DateTime          @default(now())
  expiresAt     DateTime?
  revokedAt     DateTime?
  createdAt     DateTime          @default(now())
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  product       Product?          @relation(fields: [productId], references: [id], onDelete: Restrict)
  preparation   Preparation?      @relation(fields: [preparationId], references: [id], onDelete: Restrict)
  course        Course?           @relation(fields: [courseId], references: [id], onDelete: Restrict)
  purchase      Purchase?         @relation(fields: [purchaseId], references: [id], onDelete: Restrict)

  @@unique([userId, productId, sourceKey])
  @@unique([userId, preparationId, sourceKey])
  @@unique([userId, courseId, sourceKey])
  @@index([userId, revokedAt, expiresAt])
  @@index([purchaseId])
}

model FlashcardReview {
  id             String               @id @default(cuid())
  userId         String
  flashcardId    String
  state          FlashcardReviewState @default(NEW)
  nextReviewAt   DateTime             @default(now())
  intervalDays   Int                  @default(0)
  easeFactor     Float                @default(2.5)
  repetitions    Int                  @default(0)
  lastReviewedAt DateTime?
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  flashcard      Flashcard            @relation(fields: [flashcardId], references: [id], onDelete: Cascade)

  @@unique([userId, flashcardId])
  @@index([userId, nextReviewAt])
}

model StudyRoom {
  id            String             @id @default(cuid())
  preparationId String?
  creatorId     String
  name          String
  description   String             @default("")
  isPrivate     Boolean            @default(false)
  status        ContentStatus      @default(PUBLISHED)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  preparation   Preparation?       @relation(fields: [preparationId], references: [id], onDelete: SetNull)
  creator       User               @relation("StudyRoomCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  members       StudyRoomMember[]
  messages      StudyRoomMessage[]

  @@index([preparationId, isPrivate, status])
}

model StudyRoomMember {
  roomId         String
  userId         String
  role           String    @default("MEMBER")
  joinedAt       DateTime  @default(now())
  minutesStudied Int       @default(0)
  room           StudyRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([roomId, userId])
  @@index([userId])
}

model StudyRoomMessage {
  id        String    @id @default(cuid())
  roomId    String
  userId    String
  content   String
  createdAt DateTime  @default(now())
  room      StudyRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
}

model Simulado {
  id           String        @id @default(cuid())
  vestibularId String
  title        String
  description  String
  durationMin  Int           @default(180)
  questionIds  String        @default("[]")
  status       ContentStatus @default(PUBLISHED)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  vestibular Vestibular @relation(fields: [vestibularId], references: [id], onDelete: Cascade)
}

model Challenge {
  id          String        @id @default(cuid())
  title       String
  description String
  rewardXp    Int           @default(250)
  goal        Int           @default(30)
  metric      String        @default("questions")
  status      ContentStatus @default(PUBLISHED)
  startsAt    DateTime      @default(now())
  endsAt      DateTime
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Activity {
  id        String       @id @default(cuid())
  userId    String?
  type      ActivityType @default(XP)
  message   String
  xp        Int          @default(0)
  createdAt DateTime     @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}
