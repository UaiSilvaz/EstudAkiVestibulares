generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  TEACHER
  MENTOR
  COORDINATOR
  ADMIN
}

enum ContentStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum QuestionSourceType {
  OFFICIAL
  WEB_PUBLIC
  LICENSE_REQUIRED
  AUTHORIAL
}

enum QuestionReviewState {
  PENDING_REVIEW
  APPROVED
  HAS_ERROR
}

enum QuestionReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum ProvaAntigaStatus {
  DISPONIVEL
  APROVADA
  EM_PROCESSAMENTO
  PENDENTE
  COM_ERRO
}

enum MaterialType {
  PDF
  SUMMARY
  MINDMAP
  SLIDES
  SHEET
}

enum VideoKind {
  LESSON
  EXPRESS
  RESOLUTION
}

enum ActivityType {
  XP
  QUESTION
  STREAK
  CHALLENGE
  CONTENT
}

enum PurchaseStatus {
  PENDING
  APPROVED
  REFUNDED
  CANCELED
  CHARGEBACK
}

enum CartItemStatus {
  CART
  WISHLIST
  WAITING
}

enum OfficialFileType {
  INDEX_PAGE
  EXAM
  ANSWER_KEY
}

enum OfficialSourceKind {
  SEED_PAGE
  DIRECT_FILE
}

enum OfficialSourceStatus {
  PENDING
  APPROVED
  DOWNLOADED
  ERROR
  ARCHIVED
}

enum OfficialDownloadStatus {
  PENDING
  DOWNLOADING
  DOWNLOADED
  DUPLICATE
  ERROR
}

enum OfficialProcessingStatus {
  FILE_DOWNLOADED
  WAITING_EXTRACTION
  EXTRACTING
  EXTRACTED
  WAITING_REVIEW
  APPROVED
  PUBLISHED
  ERROR
}

enum OfficialResolutionStatus {
  NOT_GENERATED
  IN_REVIEW
  APPROVED
  REJECTED
  PUBLISHED
}

enum OfficialAnswerReviewStatus {
  EXTRACTED
  CHECKED
  APPROVED
  REJECTED
}

enum QuestionImportJobStatus {
  PREPARED
  IMPORTING
  WAITING_REVIEW
  READY_TO_PUBLISH
  PUBLISHED
  FAILED
}

enum QuestionAnswerSituation {
  PENDING_OFFICIAL_KEY
  CONFIRMED
  ANNULLED
}

enum OfficialQuestionLanguage {
  NOT_APPLICABLE
  PORTUGUESE
  ENGLISH
  SPANISH
}

enum QuestionExtractionStatus {
  EXTRACTED
  NEEDS_REVIEW
  INVALID
}

enum QuestionBlockType {
  SUPPORT_TEXT
  COMMAND
  CREDIT
  IMAGE
}

enum QuestionAssetType {
  VISUAL
  PROMPT_FACSIMILE
  ALTERNATIVE_VISUAL
  ORIGINAL_REFERENCE
}

enum QuestionAssetRelation {
  STATEMENT
  ALTERNATIVE
  ADMIN_REFERENCE
}

enum QuestionRevisionAction {
  IMPORTED
  UPDATED
  APPROVED
  REOPENED
  PUBLISHED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(STUDENT)
  avatarUrl    String?
  xp           Int      @default(0)
  streak       Int      @default(0)
  league       String   @default("Bronze")
  weeklyHours  Int      @default(8)
  targetExam   String   @default("ENEM")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  activities              Activity[]
  attempts                QuestionAttempt[]
  authoredQuestions       Question[]           @relation("QuestionAuthor")
  authoredVideos          Video[]              @relation("VideoAuthor")
  achievements            UserAchievement[]
  purchases               Purchase[]
  licenses                UserProduct[]
  pdfAnnotations          PdfAnnotation[]
  studySessions           StudySession[]
  videoComments           VideoComment[]
  videoLikes              VideoLike[]
  videoSaves              VideoSave[]
  examAttempts            ExamAttempt[]
  questionFavorites       QuestionFavorite[]
  questionReports         QuestionReport[]
  cartItems               CartItem[]
  ownedFlashcards         Flashcard[]          @relation("FlashcardOwner")
  flashcardFavorites      FlashcardFavorite[]
  essays                  EssaySubmission[]
  communityPosts          CommunityPost[]
  communityPostLikes      CommunityPostLike[]
  conversationMemberships ConversationMember[]
  chatMessages            ChatMessage[]
  createdConversations    Conversation[]       @relation("ConversationCreator")
  authSessions            AuthSession[]
  studyPlanPreference     StudyPlanPreference?
  studyPlanTasks          StudyPlanTask[]
}

model AuthSession {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt, revokedAt])
}

model Vestibular {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logo        String?
  color       String   @default("#1E73FF")
  description String
  weightMap   String   @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  exams     Exam[]
  questions Question[]
  simulados Simulado[]
}

model Subject {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  color       String   @default("#1E73FF")
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  flashcards Flashcard[]
  materials  Material[]
  questions  Question[]
  topics     Topic[]
  videos     Video[]
}

model Topic {
  id        String   @id @default(cuid())
  subjectId String
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  flashcards Flashcard[]
  materials  Material[]
  questions  Question[]
  subject    Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  videos     Video[]
}

model Question {
  id                      String                   @id @default(cuid())
  vestibularId            String
  subjectId               String
  topicId                 String?
  authorId                String?
  year                    Int
  exam                    String?
  phase                   String?
  day                     String?
  questionNumber          Int?
  difficulty              Difficulty               @default(MEDIUM)
  statement               String
  supportText             String?
  alternatives            String
  alternativeExplanations String                   @default("{}")
  correctAlternative      String
  explanation             String
  pedagogyComment         String?
  skill                   String?
  videoUrl                String?
  imageUrl                String?
  images                  String                   @default("[]")
  tags                    String                   @default("[]")
  source                  String?
  sourceName              String?
  sourceUrl               String?
  sourceCitation          String?
  sourceAccessedAt        String?
  sourceType              QuestionSourceType       @default(AUTHORIAL)
  answerSituation         QuestionAnswerSituation  @default(CONFIRMED)
  officialLanguage        OfficialQuestionLanguage @default(NOT_APPLICABLE)
  officialGroup           String?
  officialVariant         String?
  reviewState             QuestionReviewState      @default(PENDING_REVIEW)
  reviewNotes             String?
  contentHash             String?                  @unique
  pilotTestPublishedAt    DateTime?
  pilotTestPublishedBy    String?
  status                  ContentStatus            @default(REVIEW)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  attempts             QuestionAttempt[]
  alternativeItems     QuestionAlternative[]
  author               User?                         @relation("QuestionAuthor", fields: [authorId], references: [id])
  imageItems           QuestionImage[]
  subject              Subject                       @relation(fields: [subjectId], references: [id])
  topic                Topic?                        @relation(fields: [topicId], references: [id])
  vestibular           Vestibular                    @relation(fields: [vestibularId], references: [id])
  videos               Video[]
  provasAntigas        ProvaAntigaQuestao[]
  favorites            QuestionFavorite[]
  reports              QuestionReport[]
  structuredExtraction QuestionExtraction?
  pedagogicalMetadata  QuestionPedagogicalMetadata?
  authorialResolutions QuestionAuthorialResolution[]
  blocks               QuestionBlock[]
  revisions            QuestionRevision[]
  officialAnswerKey    OfficialAnswerKey?

  @@index([vestibularId, status, difficulty])
  @@index([subjectId, topicId, status])
  @@index([sourceType, reviewState, status])
  @@index([year, status])
  @@index([year, questionNumber, officialLanguage])
  @@index([officialGroup, officialVariant])
  @@index([pilotTestPublishedAt])
}

model QuestionAlternative {
  id                  String   @id @default(cuid())
  questionId          String
  key                 String
  text                String
  imageUrl            String?
  explanation         String?
  correct             Boolean  @default(false)
  order               Int
  sourcePdfPage       Int?
  consolidatedPdfPage Int?
  regionX             Float?
  regionY             Float?
  regionWidth         Float?
  regionHeight        Float?
  normalizedX         Float?
  normalizedY         Float?
  normalizedWidth     Float?
  normalizedHeight    Float?
  confidence          Float?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, key])
  @@index([questionId, order])
}

model QuestionImage {
  id                  String                @id @default(cuid())
  questionId          String
  url                 String
  description         String?
  altText             String?
  order               Int                   @default(0)
  width               Int?
  height              Int?
  assetType           QuestionAssetType     @default(VISUAL)
  relation            QuestionAssetRelation @default(STATEMENT)
  alternativeKey      String?
  storagePath         String?
  mimeType            String?
  sha256Hash          String?
  sourcePdfPage       Int?
  consolidatedPdfPage Int?
  regionX             Float?
  regionY             Float?
  regionWidth         Float?
  regionHeight        Float?
  normalizedX         Float?
  normalizedY         Float?
  normalizedWidth     Float?
  normalizedHeight    Float?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  question Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  blocks   QuestionBlock[]

  @@index([questionId, order])
  @@index([questionId, assetType, relation])
  @@index([sha256Hash])
}

model QuestionAttempt {
  id                  String    @id @default(cuid())
  userId              String
  questionId          String
  selectedAlternative String
  correct             Boolean
  annulled            Boolean   @default(false)
  timeSpentSeconds    Int       @default(0)
  errorType           String?
  reviewed            Boolean   @default(false)
  createdAt           DateTime  @default(now())
  reviewedAt          DateTime?

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([questionId])
  @@index([correct, reviewed])
}

model QuestionFavorite {
  id         String   @id @default(cuid())
  userId     String
  questionId String
  createdAt  DateTime @default(now())

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId, createdAt])
}

model QuestionReport {
  id         String               @id @default(cuid())
  userId     String
  questionId String
  reason     String
  details    String?
  status     QuestionReportStatus @default(OPEN)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([questionId, status])
  @@index([userId, createdAt])
}

model Exam {
  id              String        @id @default(cuid())
  vestibularId    String
  title           String
  year            Int
  phase           String
  day             String?
  pdfUrl          String?
  answerKeyUrl    String?
  sourceUrl       String?
  imageUrl        String?
  questionCount   Int?
  durationMinutes Int?
  official        Boolean       @default(true)
  color           String        @default("#1E73FF")
  status          ContentStatus @default(PUBLISHED)
  isSimulado      Boolean       @default(false)
  description     String?
  instructions    String?
  startsAt        DateTime?
  endsAt          DateTime?
  resultsAt       DateTime?
  answerKey       String        @default("{}")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  vestibular Vestibular    @relation(fields: [vestibularId], references: [id], onDelete: Cascade)
  attempts   ExamAttempt[]
}

model ExamAttempt {
  id           String    @id @default(cuid())
  examId       String
  userId       String
  startedAt    DateTime  @default(now())
  expiresAt    DateTime
  submittedAt  DateTime?
  responses    String    @default("{}")
  status       String    @default("IN_PROGRESS")
  correctCount Int?
  score        Float?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([examId, userId])
  @@index([userId, submittedAt])
  @@index([examId, status])
}

model ProvaAntiga {
  id                      String             @id
  vestibular              String
  slug                    String             @unique
  ano                     Int
  titulo                  String
  descricao               String
  fase                    String
  dia                     String?
  tipo                    String             @default("OFICIAL")
  arquivoProvaUrl         String             @map("arquivo_prova_url")
  arquivoGabaritoUrl      String?            @map("arquivo_gabarito_url")
  arquivoProvaPath        String             @map("arquivo_prova_path")
  arquivoGabaritoPath     String?            @map("arquivo_gabarito_path")
  fonteOficial            String             @map("fonte_oficial")
  fonteUrl                String             @map("fonte_url")
  totalQuestoes           Int?               @map("total_questoes")
  status                  ProvaAntigaStatus  @default(PENDENTE)
  importacaoStatus        String             @default("NAO_INICIADA") @map("importacao_status")
  importacaoRelatorio     String?            @map("importacao_relatorio")
  officialExamFileId      String?            @unique @map("official_exam_file_id")
  officialKeyFileId       String?            @unique @map("official_key_file_id")
  fileHash                String?            @map("file_hash")
  questoesDetectadas      Int                @default(0) @map("questoes_detectadas")
  questoesValidas         Int                @default(0) @map("questoes_validas")
  questoesComErro         Int                @default(0) @map("questoes_com_erro")
  imagensDetectadas       Int                @default(0) @map("imagens_detectadas")
  pilotTestAvailableAt    DateTime?          @map("pilot_test_available_at")
  pilotTestPreviousStatus ProvaAntigaStatus? @map("pilot_test_previous_status")
  criadoEm                DateTime           @default(now()) @map("criado_em")
  atualizadoEm            DateTime           @updatedAt @map("atualizado_em")

  questoes         ProvaAntigaQuestao[]
  officialExamFile OfficialFile?           @relation("OfficialExamPdf", fields: [officialExamFileId], references: [id], onDelete: SetNull)
  officialKeyFile  OfficialFile?           @relation("OfficialAnswerKeyPdf", fields: [officialKeyFileId], references: [id], onDelete: SetNull)
  importJobs       QuestionImportJob[]
  essayProposals   OfficialEssayProposal[]

  @@index([vestibular, ano])
  @@index([status])
  @@map("provas_antigas")
}

model ProvaAntigaQuestao {
  id                   String                   @id @default(cuid())
  provaAntigaId        String                   @map("prova_antiga_id")
  questaoId            String                   @map("questao_id")
  numeroQuestao        Int                      @map("numero_questao")
  officialLanguage     OfficialQuestionLanguage @default(NOT_APPLICABLE) @map("official_language")
  officialGroup        String?                  @map("official_group")
  officialVariant      String?                  @map("official_variant")
  ordem                Int
  paginaPdf            Int?                     @map("pagina_pdf")
  extractedStatement   String?                  @map("extracted_statement")
  extractionConfidence Float?                   @map("extraction_confidence")
  pageStart            Int?                     @map("page_start")
  pageEnd              Int?                     @map("page_end")
  hasImage             Boolean                  @default(false) @map("has_image")
  needsHumanReview     Boolean                  @default(true) @map("needs_human_review")
  criadoEm             DateTime                 @default(now()) @map("criado_em")

  provaAntiga ProvaAntiga @relation(fields: [provaAntigaId], references: [id], onDelete: Cascade)
  questao     Question    @relation(fields: [questaoId], references: [id], onDelete: Cascade)

  @@unique([provaAntigaId, questaoId])
  @@unique([provaAntigaId, numeroQuestao, officialLanguage], map: "paq_exam_number_language_key")
  @@index([questaoId])
  @@index([provaAntigaId, officialGroup, officialVariant], map: "paq_exam_group_variant_idx")
  @@map("prova_antiga_questoes")
}

model OfficialSource {
  id           String               @id @default(cuid())
  vestibular   String
  year         Int?
  edition      String               @default("regular")
  examDay      String?              @map("exam_day")
  fileType     OfficialFileType     @map("file_type")
  sourceKind   OfficialSourceKind   @default(DIRECT_FILE) @map("source_kind")
  sourceUrl    String               @unique @map("source_url")
  sourceDomain String               @map("source_domain")
  status       OfficialSourceStatus @default(PENDING)
  notes        String?
  approvedAt   DateTime?            @map("approved_at")
  archivedAt   DateTime?            @map("archived_at")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  files OfficialFile[]
  logs  OfficialImportLog[]

  @@index([vestibular, year])
  @@index([status, sourceKind])
  @@map("official_sources")
}

model OfficialFile {
  id               String                   @id @default(cuid())
  sourceId         String                   @map("source_id")
  vestibular       String
  year             Int
  edition          String
  examDay          String?                  @map("exam_day")
  fileType         OfficialFileType         @map("file_type")
  originalUrl      String                   @map("original_url")
  storageUrl       String                   @map("storage_url")
  fileName         String                   @map("file_name")
  mimeType         String                   @map("mime_type")
  fileSize         Int                      @map("file_size")
  sha256Hash       String                   @unique @map("sha256_hash")
  downloadStatus   OfficialDownloadStatus   @default(PENDING) @map("download_status")
  downloadLog      String                   @default("") @map("download_log")
  processingStatus OfficialProcessingStatus @default(FILE_DOWNLOADED) @map("processing_status")
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")

  source         OfficialSource      @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  answerKeys     OfficialAnswerKey[]
  logs           OfficialImportLog[]
  examRecords    ProvaAntiga[]       @relation("OfficialExamPdf")
  keyRecords     ProvaAntiga[]       @relation("OfficialAnswerKeyPdf")
  examImportJobs QuestionImportJob[] @relation("QuestionImportExamFile")
  keyImportJobs  QuestionImportJob[] @relation("QuestionImportAnswerKeyFile")

  @@index([sourceId, downloadStatus])
  @@index([vestibular, year, fileType])
  @@index([processingStatus])
  @@map("official_files")
}

model OfficialAnswerKey {
  id                  String                     @id @default(cuid())
  fileId              String                     @map("file_id")
  questionNumber      Int                        @map("question_number")
  officialLanguage    OfficialQuestionLanguage   @default(NOT_APPLICABLE) @map("official_language")
  officialGroup       String?                    @map("official_group")
  officialVariant     String?                    @map("official_variant")
  correctAlternative  String                     @map("correct_alternative")
  questionId          String?                    @unique @map("question_id")
  answerSituation     QuestionAnswerSituation    @default(CONFIRMED) @map("answer_situation")
  sourceUrl           String?                    @map("source_url")
  sourceSha256        String?                    @map("source_sha256")
  sourcePdfPage       Int?                       @map("source_pdf_page")
  validationStatus    String?                    @map("validation_status")
  importedAt          DateTime?                  @map("imported_at")
  statement           String?
  subject             String?
  topic               String?
  difficulty          Difficulty?
  officialQuestionUrl String?                    @map("official_question_url")
  /// Legacy compatibility only. New authorial resolution content belongs to QuestionAuthorialResolution.
  shortComment        String?                    @map("short_comment")
  fullResolution      String?                    @map("full_resolution")
  steps               String                     @default("[]")
  alternativeComments String                     @default("{}") @map("alternative_comments")
  commonError         String?                    @map("common_error")
  studyTip            String?                    @map("study_tip")
  relatedContent      String?                    @map("related_content")
  answerReviewStatus  OfficialAnswerReviewStatus @default(EXTRACTED) @map("answer_review_status")
  answerReviewedBy    String?                    @map("answer_reviewed_by")
  answerReviewedAt    DateTime?                  @map("answer_reviewed_at")
  resolutionStatus    OfficialResolutionStatus   @default(NOT_GENERATED) @map("resolution_status")
  generatedByModel    String?                    @map("generated_by_model")
  generatedAt         DateTime?                  @map("generated_at")
  reviewedBy          String?                    @map("reviewed_by")
  reviewedAt          DateTime?                  @map("reviewed_at")
  publishedAt         DateTime?                  @map("published_at")
  createdAt           DateTime                   @default(now()) @map("created_at")
  updatedAt           DateTime                   @updatedAt @map("updated_at")

  file                 OfficialFile                  @relation(fields: [fileId], references: [id], onDelete: Cascade)
  question             Question?                     @relation(fields: [questionId], references: [id], onDelete: SetNull)
  extraction           QuestionExtraction?
  authorialResolutions QuestionAuthorialResolution[]

  @@unique([fileId, questionNumber, officialLanguage], map: "official_answer_keys_file_number_language_key")
  @@index([fileId, officialGroup, officialVariant], map: "official_answer_keys_file_group_variant_idx")
  @@index([answerReviewStatus, updatedAt])
  @@index([resolutionStatus, updatedAt])
  @@map("official_answer_keys")
}

model OfficialImportLog {
  id        String   @id @default(cuid())
  sourceId  String?  @map("source_id")
  fileId    String?  @map("file_id")
  action    String
  status    String
  message   String
  metadata  String   @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  source OfficialSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  file   OfficialFile?   @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@index([sourceId, createdAt])
  @@index([fileId, createdAt])
  @@map("official_import_logs")
}

model QuestionImportJob {
  id                         String                  @id @default(cuid())
  pilotId                    String                  @unique @map("pilot_id")
  provaAntigaId              String                  @map("prova_antiga_id")
  examFileId                 String                  @map("exam_file_id")
  answerKeyFileId            String                  @map("answer_key_file_id")
  vestibular                 String
  year                       Int
  day                        Int
  application                String
  modality                   String
  bookletNumber              Int                     @map("booklet_number")
  bookletColor               String                  @map("booklet_color")
  manifestPath               String                  @map("manifest_path")
  sourceJsonPath             String                  @map("source_json_path")
  sourceJsonSha256           String                  @map("source_json_sha256")
  sourceSchemaVersion        Int                     @default(1) @map("source_schema_version")
  expectedQuestionCount      Int                     @default(90) @map("expected_question_count")
  importedQuestionCount      Int                     @default(0) @map("imported_question_count")
  approvedQuestionCount      Int                     @default(0) @map("approved_question_count")
  publishedQuestionCount     Int                     @default(0) @map("published_question_count")
  requirePedagogicalReview   Boolean                 @default(false) @map("require_pedagogical_review")
  requireAuthorialResolution Boolean                 @default(false) @map("require_authorial_resolution")
  requireEssayProposal       Boolean                 @default(false) @map("require_essay_proposal")
  approvedPedagogicalCount   Int                     @default(0) @map("approved_pedagogical_count")
  approvedResolutionCount    Int                     @default(0) @map("approved_resolution_count")
  publishedResolutionCount   Int                     @default(0) @map("published_resolution_count")
  approvedEssayProposalCount Int                     @default(0) @map("approved_essay_proposal_count")
  status                     QuestionImportJobStatus @default(PREPARED)
  validationReport           Json                    @default("{}") @map("validation_report")
  checkpoint                 Json                    @default("{}")
  createdBy                  String                  @map("created_by")
  startedAt                  DateTime?               @map("started_at")
  completedAt                DateTime?               @map("completed_at")
  publishedAt                DateTime?               @map("published_at")
  createdAt                  DateTime                @default(now()) @map("created_at")
  updatedAt                  DateTime                @updatedAt @map("updated_at")

  provaAntiga          ProvaAntiga                   @relation(fields: [provaAntigaId], references: [id], onDelete: Restrict)
  examFile             OfficialFile                  @relation("QuestionImportExamFile", fields: [examFileId], references: [id], onDelete: Restrict)
  answerKeyFile        OfficialFile                  @relation("QuestionImportAnswerKeyFile", fields: [answerKeyFileId], references: [id], onDelete: Restrict)
  extractions          QuestionExtraction[]
  revisions            QuestionRevision[]
  essayProposal        OfficialEssayProposal?
  pedagogicalMetadata  QuestionPedagogicalMetadata[]
  authorialResolutions QuestionAuthorialResolution[]

