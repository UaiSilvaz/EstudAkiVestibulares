{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["resolutions"],
  "properties": {
    "resolutions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceId",
          "officialNumber",
          "language",
          "officialAnswer",
          "answerVerified",
          "answerVerification",
          "shortComment",
          "fullResolution",
          "reasoningPath",
          "steps",
          "alternativeComments",
          "commonError",
          "studyTip",
          "keywords",
          "relatedContent",
          "difficulty",
          "estimatedMinutes",
          "knowledgeArea",
          "disciplinaryComponent",
          "content",
          "subcontent"
        ],
        "properties": {
          "sourceId": { "type": "string", "minLength": 1 },
          "officialNumber": { "type": "integer", "minimum": 1, "maximum": 180 },
          "language": { "type": "string", "enum": ["NOT_APPLICABLE", "ENGLISH", "SPANISH", "PORTUGUESE"] },
          "officialAnswer": { "type": "string", "enum": ["A", "B", "C", "D", "E", "ANULADA"] },
          "answerVerified": { "type": "boolean" },
          "answerVerification": { "type": "string", "minLength": 60 },
          "shortComment": { "type": "string", "minLength": 40 },
          "fullResolution": { "type": "string", "minLength": 180 },
          "reasoningPath": {
            "type": "array",
            "minItems": 2,
            "items": { "type": "string", "minLength": 15 }
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 15 }
          },
          "alternativeComments": {
            "type": "object",
            "additionalProperties": false,
            "required": ["A", "B", "C", "D", "E"],
            "properties": {
              "A": { "type": "string", "minLength": 25 },
              "B": { "type": "string", "minLength": 25 },
              "C": { "type": "string", "minLength": 25 },
              "D": { "type": "string", "minLength": 25 },
              "E": { "type": "string", "minLength": 25 }
            }
          },
          "commonError": { "type": "string", "minLength": 30 },
          "studyTip": { "type": "string", "minLength": 30 },
          "keywords": {
            "type": "array",
            "minItems": 2,
            "items": { "type": "string", "minLength": 2 }
          },
          "relatedContent": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 3 }
          },
          "difficulty": { "type": "string", "enum": ["EASY", "MEDIUM", "HARD"] },
          "estimatedMinutes": { "type": "integer", "minimum": 1, "maximum": 20 },
          "knowledgeArea": { "type": "string", "minLength": 3 },
          "disciplinaryComponent": { "type": "string", "minLength": 3 },
          "content": { "type": "string", "minLength": 3 },
          "subcontent": { "type": "string", "minLength": 3 }
        }
      }
    }
  }
}
