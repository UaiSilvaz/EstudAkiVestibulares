{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["areaCode", "areaName", "competencies"],
  "properties": {
    "areaCode": { "type": "string", "enum": ["LC", "MT", "CN", "CH"] },
    "areaName": { "type": "string", "minLength": 10 },
    "competencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "description", "skills"],
        "properties": {
          "code": { "type": "string" },
          "description": { "type": "string", "minLength": 20 },
          "skills": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "description"],
              "properties": {
                "code": { "type": "string" },
                "description": { "type": "string", "minLength": 15 }
              }
            }
          }
        }
      }
    }
  }
}
