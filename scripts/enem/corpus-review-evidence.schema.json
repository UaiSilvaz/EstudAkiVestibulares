{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "corpusId", "complete", "generatedAt", "questions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "corpusId": { "type": "string", "minLength": 1 },
    "complete": { "type": "boolean" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceId", "officialNumber", "language", "reviewedAt", "reviewer", "checks", "evidence", "notes"],
        "properties": {
          "sourceId": { "type": "string", "minLength": 1 },
          "officialNumber": { "type": "integer", "minimum": 1, "maximum": 180 },
          "language": { "enum": ["ENGLISH", "SPANISH", "PORTUGUESE", "NOT_APPLICABLE"] },
          "reviewedAt": { "type": "string", "format": "date-time" },
          "reviewer": { "type": "string", "minLength": 1 },
          "notes": { "type": "string", "minLength": 1 },
          "checks": {
            "type": "object",
            "additionalProperties": false,
            "required": ["statementComplete", "elementOrderCorrect", "alternativesComplete", "imagesLegible", "officialAnswerConfirmed", "numberYearDayCorrect", "originalPageAccessible", "noMixedContent"],
            "properties": {
              "statementComplete": { "const": true },
              "elementOrderCorrect": { "const": true },
              "alternativesComplete": { "const": true },
              "imagesLegible": { "const": true },
              "officialAnswerConfirmed": { "const": true },
              "numberYearDayCorrect": { "const": true },
              "originalPageAccessible": { "const": true },
              "noMixedContent": { "const": true }
            }
          },
          "evidence": { "$ref": "#/$defs/evidence" }
        }
      }
    },
    "essay": {
      "type": ["object", "null"],
      "required": ["reviewedAt", "reviewer", "checks", "evidence", "notes"],
      "properties": {
        "reviewedAt": { "type": "string", "format": "date-time" },
        "reviewer": { "type": "string", "minLength": 1 },
        "notes": { "type": "string", "minLength": 1 },
        "checks": {
          "type": "object",
          "additionalProperties": false,
          "required": ["themeComplete", "promptComplete", "instructionsComplete", "imagesLegible", "originalPageAccessible", "noMixedContent"],
          "properties": {
            "themeComplete": { "const": true },
            "promptComplete": { "const": true },
            "instructionsComplete": { "const": true },
            "imagesLegible": { "const": true },
            "originalPageAccessible": { "const": true },
            "noMixedContent": { "const": true }
          }
        },
        "evidence": { "$ref": "#/$defs/evidence" }
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "kind"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "kind": { "type": "string", "minLength": 1 },
          "note": { "type": "string" }
        }
      }
    }
  }
}
