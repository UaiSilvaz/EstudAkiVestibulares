{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "corpusId", "complete", "testedAt", "tester", "baseUrl", "testedSourceIds", "checks", "evidence", "notes"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "corpusId": { "type": "string", "minLength": 1 },
    "complete": { "const": true },
    "testedAt": { "type": "string", "format": "date-time" },
    "tester": { "type": "string", "minLength": 1 },
    "baseUrl": { "type": "string", "format": "uri" },
    "testedSourceIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["answerFlow", "correction", "mobile", "adminOriginalPage", "answerKeyNotLeaked", "languageSelection"],
      "properties": {
        "answerFlow": { "const": true },
        "correction": { "const": true },
        "mobile": { "const": true },
        "adminOriginalPage": { "const": true },
        "answerKeyNotLeaked": { "const": true },
        "languageSelection": { "const": true }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "kind"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "kind": { "type": "string", "minLength": 1 },
          "note": { "type": "string" }
        }
      }
    },
    "notes": { "type": "string", "minLength": 1 }
  }
}
